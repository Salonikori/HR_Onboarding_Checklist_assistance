# Copy this file to `.env` in the project root and fill in your SMTP details
# to enable real outbound emails (task assignment + automatic reminders).
# If left unset, emails are logged to data/email_outbox.log instead of being
# sent, so the app still runs without any mail server configured.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_address@gmail.com
# Use an app password, not your normal account password (e.g. Gmail App Passwords).
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_address@gmail.com
SMTP_FROM_NAME=OnboardAI
SMTP_USE_TLS=true
EMAIL_NOTIFICATIONS_ENABLED=true

# Automated reminder scheduler
REMINDER_LOOKAHEAD_DAYS=2
REMINDER_COOLDOWN_HOURS=24
REMINDER_CHECK_INTERVAL_MINUTES=60

# Optional: grounded AI explanations (existing feature)
# GROQ_API_KEY=

GROQ_MODEL=llama-3.1-8b-instant
